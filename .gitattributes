# Built by tools/build_ipadic.py and tools/build_kana_table.py: not text, and not worth a diff.
crates/core/data/ipadic_compact.bin binary linguist-generated
crates/core/data/kana_trigrams.bin binary linguist-generated
crates/core/tests/golden/* -text -diff linguist-generated

# Run on Linux and macOS: never CRLF.
*.sh text eol=lf
platforms/linux/Makefile text eol=lf
platforms/linux/*.c text eol=lf
platforms/linux/*.in text eol=lf
platforms/macos/* text eol=lf

# Checked by Prettier (endOfLine lf) in CI on Windows: never CRLF.
crates/config/src/web/* text eol=lf
.github/**/*.yml text eol=lf
